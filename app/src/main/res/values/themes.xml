<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmsBridgePro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/emerald_500</item>
        <item name="colorPrimaryVariant">@color/emerald_600</item>
        <item name="colorOnPrimary">@color/bg_dark</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/emerald_400</item>
        <item name="colorSecondaryVariant">@color/emerald_neon</item>
        <item name="colorOnSecondary">@color/bg_dark</item>

        <!-- Background & Surface colors -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
    </style>
</resources>
